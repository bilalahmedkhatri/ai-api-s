# Backend D:/AIModels_SearchAPIS/.env only. No app IDs are required.
# Stable blog app keys are independent of authorized_apps.
# PostgreSQL URL format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Percent-encode credentials. Leave unavailable app URLs blank.
BLOG_AZEEMLAB_DATABASE_URL=
BLOG_AILETTERGEN_DATABASE_URL=
BLOG_BONDSGAME_DATABASE_URL=
BLOG_SIKANDERART_DATABASE_URL=
BLOG_E_SAHULAT_DATABASE_URL=
BLOG_GENZEE_VIDEO_DATABASE_URL=

# Confirmed public blog routes; leave unavailable apps blank.
BLOG_AZEEMLAB_PUBLIC_BLOG_URL=https://www.azeemlab.com/en/blog
BLOG_AILETTERGEN_PUBLIC_BLOG_URL=https://ailettergen.com/en/blog
BLOG_BONDSGAME_PUBLIC_BLOG_URL=https://www.bondsgame.click/news
BLOG_SIKANDERART_PUBLIC_BLOG_URL=
BLOG_E_SAHULAT_PUBLIC_BLOG_URL=
BLOG_GENZEE_VIDEO_PUBLIC_BLOG_URL=https://www.genzee.video/en/blog

# Dedicated public BLOG storage only; existing audio/log B2 settings are separate.
BLOG_B2_BUCKET_NAME=blogPost001
BLOG_B2_APPLICATION_KEY_ID=
BLOG_B2_APPLICATION_KEY=
BLOG_B2_ENDPOINT_URL=
BLOG_B2_PUBLIC_BASE_URL=
